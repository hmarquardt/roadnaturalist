{
  "name": "roadnaturalist",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 8000",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "verify:occurrence:live": "node scripts/verify-occurrence-live.mjs",
    "verify:occurrence:browser": "RUN_OCCURRENCE_LIVE=1 playwright test tests/occurrence-live.spec.js",
    "verify:investigator:live": "node scripts/verify-investigator-live.mjs",
    "verify:investigator:worker": "node scripts/verify-investigator-worker.mjs",
    "stage:pages": "node scripts/stage-pages.mjs",
    "deploy:pages": "node scripts/deploy-pages.mjs",
    "deploy:worker": "cd worker && npx --yes wrangler@4.135.0 deploy",
    "verify:production:browser": "RUN_PRODUCTION_LIVE=1 playwright test tests/production-live.spec.js",
    "validate:probes": "node scripts/validate-probes.mjs",
    "verify:geometry": "node scripts/verify-geometry.mjs",
    "build:regional": "uv run --with duckdb --with pyproj --with shapely --with pyarrow --with pyshp --with numpy python3 scripts/build-regional.py",
    "verify:regional": "uv run --python 3.12 --with duckdb python3 scripts/verify-regional.py",
    "investigator:refresh": "node scripts/refresh-investigator-evidence.mjs",
    "benchmark:regional": "RUN_REGIONAL_BENCHMARK=1 playwright test tests/regional-benchmark.spec.js --reporter=line --retries=0",
    "publish:regional": "node scripts/publish-regional.mjs",
    "audit:regional:remote": "node scripts/audit-regional-remote.mjs",
    "verify:regional-equivalence": "node scripts/verify-regional-equivalence.mjs",
    "capture:regional-equivalence": "RUN_REGIONAL_EQUIVALENCE_CAPTURE=1 playwright test tests/regional-equivalence.capture.spec.js --reporter=line --retries=0",
    "verify:regional:production": "RUN_REGIONAL_PRODUCTION=1 playwright test tests/regional-production.spec.js --reporter=line --retries=0",
    "verify:regional:remote": "RUN_REGIONAL_REMOTE=1 playwright test tests/regional-remote.spec.js --reporter=line --retries=0",
    "verify:search:production": "RUN_SEARCH_PRODUCTION=1 playwright test tests/search-production.spec.js --reporter=line --retries=0",
    "verify:geolocation:production": "RUN_GEOLOCATION_PRODUCTION=1 playwright test tests/geolocation-production.spec.js --reporter=line --retries=0",
    "benchmark:geolocation": "RUN_GEOLOCATION_BENCHMARK=1 playwright test tests/geolocation.spec.js --reporter=line --retries=0 -g benchmark",
    "build:derived": "uv run --python 3.12 --with duckdb --with shapely --with pyarrow --with pyproj python3 scripts/build-derived.py",
    "build:places": "python3 scripts/build-places.py --download",
    "verify:places": "python3 scripts/build-places.py --verify-artifacts",
    "check:places": "python3 scripts/build-places.py --check",
    "verify:places:production": "RUN_PLACE_PRODUCTION=1 playwright test tests/place-production.spec.js --reporter=line --retries=0",
    "verify:derived-equivalence": "node scripts/verify-derived-equivalence.mjs",
    "verify:derived": "uv run --python 3.12 --with duckdb --with shapely python3 scripts/verify-derived.py",
    "capture:derived-equivalence": "RUN_DERIVED_EQUIVALENCE_CAPTURE=1 playwright test tests/derived-equivalence.capture.spec.js --reporter=line --retries=0",
    "benchmark:derived": "RUN_DERIVED_BENCHMARK=1 playwright test tests/derived-benchmark.spec.js --reporter=line --retries=0",
    "benchmark:candidates": "RUN_CANDIDATE_STORAGE_BENCHMARK=1 playwright test tests/candidate-storage-benchmark.spec.js --reporter=line --retries=0",
    "benchmark:search": "RUN_SEARCH_BENCHMARK=1 playwright test tests/search-benchmark.spec.js --reporter=line --retries=0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
